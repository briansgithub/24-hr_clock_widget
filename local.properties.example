# Android SDK location (automatically managed by Android Studio)
sdk.dir=/path/to/your/android/sdk

# Fitbit API Credentials (from https://dev.fitbit.com)
FITBIT_CLIENT_ID=YOUR_CLIENT_ID_HERE
FITBIT_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Optional free silent push relay. Blank values keep ordinary polling enabled.
SLEEP_RELAY_URL=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=
